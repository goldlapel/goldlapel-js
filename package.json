{
  "name": "goldlapel",
  "version": "0.0.0",
  "description": "Self-optimizing Postgres proxy — automatic materialized views and indexes",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cli.js",
    "cache.js",
    "ddl.js",
    "wrap.js",
    "utils.js",
    "bin/",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "bin": {
    "goldlapel": "cli.js"
  },
  "keywords": [
    "postgres",
    "proxy",
    "optimization",
    "materialized-views",
    "database"
  ],
  "author": "Stephen Gibson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goldlapel/goldlapel-js.git"
  },
  "bugs": {
    "url": "https://github.com/goldlapel/goldlapel-js/issues"
  },
  "homepage": "https://goldlapel.com",
  "scripts": {
    "test": "node --test test/*.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "@goldlapel/darwin-arm64": "0.1.0-rc16",
    "@goldlapel/darwin-x64": "0.1.0-rc16",
    "@goldlapel/linux-arm64": "0.1.0-rc16",
    "@goldlapel/linux-arm64-musl": "0.1.0-rc16",
    "@goldlapel/linux-x64": "0.1.0-rc16",
    "@goldlapel/linux-x64-musl": "0.1.0-rc16",
    "@goldlapel/win-x64": "0.1.0-rc16"
  },
  "peerDependencies": {
    "pg": "^8.20.0",
    "postgres": "^3.4.0",
    "@vercel/postgres": "^0.10.0"
  },
  "peerDependenciesMeta": {
    "pg": { "optional": true },
    "postgres": { "optional": true },
    "@vercel/postgres": { "optional": true }
  },
  "workspaces": [
    "packages/*"
  ]
}
